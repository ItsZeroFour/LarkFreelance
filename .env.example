# ============================================================
# Lark Freelance — переменные окружения
# Скопируйте этот файл в `.env` (на сервере) и заполните значения.
# Без них форма заявки и бриф Larkins НЕ ОТПРАВЛЯЮТСЯ никуда.
# ============================================================

# ---------- Доставка заявок в Telegram ----------
# Заявки с формы «Перезвоните мне» и бриф Larkins падают сюда.
#
# 1) Создайте бота у @BotFather → получите токен вида 123456789:AA...
#    (именно ПОЛНЫЙ токен, включая часть до двоеточия).
# 2) Напишите своему боту любое сообщение (иначе он не сможет вам писать).
# 3) Узнайте chat_id: откройте
#    https://api.telegram.org/bot<ВАШ_ТОКЕН>/getUpdates
#    и возьмите поле "chat":{"id": ... }. Для канала id начинается с -100.
#
# Симптом неверного токена в логах: «Telegram ответил 404».
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Доставка заявок на почту (Resend) ----------
# Резервный/дублирующий канал. Можно не заполнять, если хватает Telegram.
#
# ВАЖНО про режим тестирования Resend:
#   Пока домен не подтверждён, Resend отправляет письма ТОЛЬКО на адрес
#   владельца аккаунта. Отправка на любой другой адрес вернёт 403
#   («You can only send testing emails to your own email address»).
#
# Варианты:
#   A) Быстро: LEAD_EMAIL_TO = адрес владельца аккаунта Resend,
#      RESEND_FROM оставить пустым (по умолчанию onboarding@resend.dev).
#   B) Правильно: подтвердить свой домен на resend.com/domains и указать
#      RESEND_FROM с адресом на этом домене — тогда LEAD_EMAIL_TO любой.
RESEND_API_KEY=
LEAD_EMAIL_TO=
# Напр.: "Lark Freelance <hello@ваш-домен.ru>". Пусто = onboarding@resend.dev
RESEND_FROM=

# ---------- Larkins AI (консоль-бриф) ----------
# Ключ Anthropic для диалога Larkins. Без него работают только
# «секретные фразы», а осмысленный сбор брифа — нет.
ANTHROPIC_API_KEY=

# ---------- Публичный адрес сайта ----------
# Задаёт canonical, og:url, sitemap.xml, robots.txt и JSON-LD.
# По умолчанию (если переменная пуста) берётся https://lark.eco — боевой
# домен. Заполнять нужно ТОЛЬКО для превью/стейджинга, например
# https://staging.lark.eco. Указывать со схемой, без слеша на конце.
# Ошибка здесь не видна на сайте, но уводит всю выдачу на чужой адрес.
NEXT_PUBLIC_SITE_URL=
